# Copie para .env antes de usar docker compose.
JWT_SECRET=change-me-before-sharing
# Chave da Google Gemini usada pelo agente de chat (tool calling). Sem ela, o chat responde 503.
# Gere uma gratuitamente em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo da Gemini usado pelo chat (padrão: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/atlas-catalog
JWT_SECRET=change-me-in-development
CLIENT_URL=http://localhost:5173
# Chave da Google Gemini usada pelo agente de chat (tool calling). Sem ela, POST /chat responde 503.
# Gere uma gratuitamente em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo da Gemini usado pelo chat (padrão: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
